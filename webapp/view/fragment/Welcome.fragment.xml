<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:f="sap.ui.layout.form"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core">
	<Dialog
		contentWidth="550px"
		id="mainDialog"
		title="{i18n>titleWelcome}">
		<content>
			<VBox class="sapUiSmallMargin" id="formContainer">
				<f:SimpleForm id="SimpleFormChangeColumn_twoGroups234"
					editable="true"
					layout="ColumnLayout"
					title="{i18n>subTitle} {/supplierS4/SupplierName}"
					columnsM="1"
					columnsL="1"
					columnsXL="1">
					<f:content>
						<Text text="Bem vindo à versão inicial da tela de cadastro no GFEx.
							A proposta desta tela é o fornecedor identificar os grupos de materiais que ele detém direito de exclusividade.
							As informações são obtidas do banco de dados PETROBRAS. O fornecedor pode remover de seu escopo mas não adicionar.
							Opere a solução e sugira melhorias e correções, desde textos até bugs.
							A PETROBRAS e o time GFEx agradecem o vosso apoio." />
					</f:content>
				</f:SimpleForm>
			</VBox>
			<VBox class="sapUiSmallMargin" id="formContainerEmployment" items="{
					path: '/employment'
				}">
				<f:SimpleForm editable="true"
					layout="ColumnLayout"
					title="Personal"
					columnsM="2"
					columnsL="2"
					columnsXL="2">
					<f:content>
						<core:Title text="Information" />
						<Label text="Job Classification" />
						<Input value="{jobTitle}" />
						<Label text="Pay Grade" />
						<Input value="{payGrade}"></Input>
						<Label text="Unit" />
						<Input value="{unit}"></Input>
						<core:Title text="Rating" />
						<Label text="Employee Class" />
						<Input value="{class}" />
						<Label text="FTE" />
						<Input value="{fte}"></Input>
						<Label text="Standard Weekly Hours" />
						<Input change="onChange" value="{
							path: 'weeklyHours',
							type: 'sap.ui.model.type.Integer',
							constraints: {
								maximum: 40
							}
						}"></Input>
					</f:content>
				</f:SimpleForm>
			</VBox>
		</content>
		<footer>
			<Toolbar>
				<ToolbarSpacer />
						<Button id="closeDialog"
						text="Fechar"
						type="Default"
						press="_closeDialog($event, 'Welcome')"
						ariaHasPopup="Dialog" />
			</Toolbar>
		</footer>
	</Dialog>
</core:FragmentDefinition>